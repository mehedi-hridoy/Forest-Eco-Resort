# Neon PostgreSQL pooled connection string
DATABASE_URL=

# Administrator login (signing in with these always works as Super Admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL, e.g. https://forest-eco-resort.vercel.app
NEXT_PUBLIC_SITE_URL=

# Random secret for the daily Vercel Cron job
CRON_SECRET=

# Optional: Vercel Blob read-write token (enables large files and videos)
BLOB_READ_WRITE_TOKEN=

# Optional: SMTP for lead notifications and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SALES_NOTIFICATION_EMAIL=
